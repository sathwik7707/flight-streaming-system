# OpenSky OAuth2 API client credentials.
# Leave both blank to use anonymous access (lower quota).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Frankfurt Airport (EDDF) surrounding airspace bounding box
LAT_MIN=49.85
LAT_MAX=50.25
LON_MIN=8.25
LON_MAX=8.85

# Conservative default for anonymous access: 300 seconds.
POLL_INTERVAL_SECONDS=300

# Analytics and local persistence
DB_PATH=data/flight_monitor.db
DENSITY_THRESHOLD=20
WINDOW_SECONDS=300
ZONE_SIZE_DEGREES=0.1
LOW_SPEED_THRESHOLD_MPS=35
LOW_SPEED_ALTITUDE_M=600

# Kafka exposed on the host by docker-compose.yml
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_AIRCRAFT=aircraft-positions
KAFKA_CONSUMER_GROUP=frankfurt-flight-monitor
